#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 60

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        Clear_all_BLE_profiles {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <10 11 12 13 19 20 21 18>;
        };

        to_AML {
            bindings = <&lt_to_layer_0 3 0>;
            key-positions = <32 33>;
        };

        Left_shift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <22 39>;
        };

        Right_shift {
            bindings = <&kp RIGHT_SHIFT>;
            key-positions = <40 21>;
        };

        RIGHT_SHIFT2 {
            bindings = <&kp RIGHT_SHIFT>;
            key-positions = <21 20>;
        };

        LEFT_SHIFT2 {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <22 23>;
        };

        num_layer {
            bindings = <&mkp MB2>;
            key-positions = <31 32>;
        };

        Caps_Lock {
            bindings = <&kp LA(LEFT_GUI)>;
            key-positions = <36 35>;
        };

        layar_1 {
            bindings = <&lt_to_layer_0 1 0>;
            key-positions = <40 41>;
        };

        ctrl {
            bindings = <&kp LSHIFT>;
            key-positions = <40 21>;
        };

        drag {
            bindings = <&lt_to_layer_0 6 0>;
            key-positions = <33 41>;
        };

        layer_1 {
            bindings = <&lt_to_layer_0 1 0>;
            key-positions = <33 40>;
        };
    };

    macros {
        double_kp_00: double_kp_00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMBER_0 &kp KP_NUMBER_0>;
            label = "double_kp_00";
        };

        kp_left_arrow: kp_left_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Z &kp H>;
            label = "kp_left_arrow";
        };

        kp_down_arrow: kp_down_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Z &kp J>;
            label = "kp_down_arrow";
        };

        kp_up_arrow: kp_up_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Z &kp K>;
            label = "kp_up_arrow";
        };

        kp_right_arrow: kp_right_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Z &kp L>;
            label = "KP_RIGHT_ARROW";
        };

        mb2_then_return_default_layer: mb2_then_default_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mkp MB2>, <&macro_wait_time 250>, <&to 0>;

            label = "MB2_THEN_RETURN_DEFAULT_RAYER";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&double_kp_00>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        encoder_msc_up_down: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <50>;  // デバウンスと暴走防止
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q          &kp W         &kp E             &kp R            &kp T                                      &kp Y            &kp U  &kp I     &kp O               &kp P
&kp A          &kp S         &kp D             &kp F            &kp G        &none          &bt BT_SEL 0   &kp H            &kp J  &kp K     &kp L               &kp ENTER
&kp Z          &kp X         &kp C             &kp V            &kp B        &kp GLOBE      &bt BT_SEL 1   &kp N            &kp M  &mkp MB1  &mt RIGHT_ALT SEMI  &kp DELETE
&mt LCTRL ESC  &kp LEFT_ALT  &kp LEFT_COMMAND  &lt 3 LC(SPACE)  &lt 2 SPACE  &lt 1 TAB      &kp BACKSPACE  &lt 2 RA(SPACE)                                       &kp RA(RC(RG(RIGHT_SHIFT)))
            >;

            sensor-bindings = <&encoder_msc_up_down>;
        };

        Symbol {
            bindings = <
&kp F6           &kp F7          &kp F8            &kp F9                &kp F10                                                    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS       &kp TILDE         &kp PIPE
&kp EXCLAMATION  &kp AT          &kp_up_arrow      &kp HASH              &kp CARET             &none                     &none      &kp AMPERSAND         &kp ASTERISK           &kp UNDERSCORE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&kp LEFT_SHIFT   &kp_left_arrow  &kp_down_arrow    &kp_right_arrow       &kp LG(LC(SPACE))     &kp LS(LG(NUMBER_5))      &none      &kp LESS_THAN         &kp GREATER_THAN       &kp COMMA       &kp PERIOD        &kp SQT
&kp LCTRL        &kp LEFT_ALT    &kp LEFT_COMMAND  &kp LG(LS(NUMBER_2))  &kp LG(LS(NUMBER_4))  &kp LS(LG(O))             &kp RG(Z)  &kp RS(RG(Z))                                                                  &kp SLASH
            >;

            sensor-bindings = <&inc_dec_kp BACKSPACE DELETE>;
        };

        FUNCTION {
            bindings = <
&kp LG(Q)         &kp LG(W)                   &kp LG(LC(F))       &kp LG(R)                    &kp LG(T)                                    &kp RC(LEFT_ARROW)                &kp RS(RC(TAB))        &kp RC(UP_ARROW)  &kp RC(TAB)      &kp RC(RIGHT_ARROW)
&kp RG(A)         &kp LC(LA(LG(LEFT_ARROW)))  &kp LA(LC(A))       &kp LC(LA(LG(RIGHT_ARROW)))  &kp LG(PLUS)   &trans             &trans     &kp RG(LEFT_BRACKET)              &kp RG(RIGHT_BRACKET)  &kp UP_ARROW      &kp RG(RC(V))    &kp RG(V)
&kp LEFT_SHIFT    &kp LA(LC(LEFT_ARROW))      &kp LC(DOWN_ARROW)  &kp LA(LC(RIGHT_ARROW))      &kp LG(MINUS)  &kp GLOBE          &kp GRAVE  &mt RIGHT_CONTROL RG(LEFT_ARROW)  &kp LEFT_ARROW         &kp DOWN_ARROW    &kp RIGHT_ARROW  &mt RIGHT_ALT RG(RIGHT_ARROW)
&mt RCTRL ESCAPE  &kp LEFT_ALT                &kp LEFT_COMMAND    &kp LA(TAB)                  &kp LG(N0)     &kp LG(LA(L))      &kp RG(X)  &kp RG(C)                                                                                   &mt RIGHT_COMMAND RG(F)
            >;

            sensor-bindings = <&inc_dec_kp BACKSPACE SPACE>;
        };

        NUM {
            bindings = <
&kp LS(TAB)          &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9    &kp TAB                                                  &kp RA(Y)         &kp DOLLAR          &kp COLON                &kp TILDE             &kp PERCENT
&kp LEFT_ARROW       &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6    &kp RIGHT_ARROW  &trans                   &trans         &kp KP_PLUS       &kp KP_MINUS        &kp KP_ASTERISK          &kp KP_SLASH          &kp ENTER
&kp KP_N0            &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3    &kp KP_EQUAL     &mt LEFT_COMMAND F2      &trans         &kp RA(UP_ARROW)  &kp RA(DOWN_ARROW)  &mt RIGHT_COMMAND COMMA  &mt RIGHT_ALT PERIOD  &kp DELETE
&mt LEFT_GUI ESCAPE  &double_kp_00    &kp SPACE        &kp LS(LG(SPACE))  &kp LG(SPACE)    &kp LG(LS(B))            &kp BACKSPACE  &mt F4 RG(P)                                                                         &mt RCTRL RG(L)
            >;

            sensor-bindings = <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans             &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans             &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &kp RIGHT_CONTROL  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                     &trans
            >;
        };

        drag_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans                  &trans                  &trans                   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans                  &kp RS(RA(UP_ARROW))    &trans                   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp RS(RA(LEFT_ARROW))  &kp RS(RA(DOWN_ARROW))  &kp RS(RA(RIGHT_ARROW))  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                                           &trans
            >;
        };
    };
};
