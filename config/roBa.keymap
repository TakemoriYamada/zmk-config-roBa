#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 60

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        Clear_all_BLE_profiles {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <10 11 12 13 19 20 21 18>;
        };

        to_AML {
            bindings = <&lt_to_layer_0 3 0>;
            key-positions = <32 33>;
        };

        Left_shift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <22 39>;
        };

        Right_shift {
            bindings = <&kp RIGHT_SHIFT>;
            key-positions = <40 21>;
        };

        RIGHT_SHIFT2 {
            bindings = <&kp RIGHT_SHIFT>;
            key-positions = <21 20>;
        };

        LEFT_SHIFT2 {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <22 23>;
        };

        mb2_combo {
            bindings = <&mkp MB2>;
            key-positions = <31 32>;
        };

        Caps_Lock {
            bindings = <&kp LA(LEFT_GUI)>;
            key-positions = <36 35>;
        };

        layar1 {
            bindings = <&lt_to_layer_0 1 0>;
            key-positions = <40 41>;
        };

        ctrl {
            bindings = <&lt_to_layer_0 1 0>;
            key-positions = <40 33>;
        };

        Consumer_subfunction1 {
            bindings = <&lt_to_layer_0 6 0>;
            key-positions = <41 33>;
        };

        Consumer_subfunction2 {
            bindings = <&lt_to_layer_0 6 0>;
            key-positions = <38 22>;
        };
    };

    macros {
        double_kp_00: double_kp_00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMBER_0 &kp KP_NUMBER_0>;
            label = "double_kp_00";
        };

        kp_left_arrow: kp_left_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Z &kp H>;
            label = "kp_left_arrow";
        };

        kp_down_arrow: kp_down_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Z &kp J>;
            label = "kp_down_arrow";
        };

        kp_up_arrow: kp_up_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Z &kp K>;
            label = "kp_up_arrow";
        };

        kp_right_arrow: kp_right_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Z &kp L>;
            label = "KP_RIGHT_ARROW";
        };

        id: ps {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(A) &kp LS(B) &kp LS(S) &kp N2 &kp N2 &kp N5 &kp N7>;
            label = "PS";
        };

        miniPC_pass: ID {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N0 &kp N0 &kp N1 &kp N2 &kp N3 &kp N2 &kp N7 &kp AT_SIGN &kp B &kp S &kp LS(R)>;
            label = "ID";
        };

        mb2_then_return_default_layer: mb2_then_default_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mkp MB2>, <&macro_wait_time 250>, <&to 0>;

            label = "MB2_THEN_RETURN_DEFAULT_RAYER";
        };

        AMC_pass: password2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp M &kp C &kp N0 &kp N7 &kp N1 &kp N3 &kp N1 &kp N0>;
            label = "PASSWORD2";
        };

        ipad_pass: password3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N7 &kp N1 &kp N3 &kp N1 &kp N0>;
            label = "PASSWORD3";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&double_kp_00>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        encoder_msc_up_down: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <50>;  // デバウンスと暴走防止
        };

        F2_Enter: F2_Enter {
            compatible = "zmk,behavior-tap-dance";
            label = "F2_ENTER";
            #binding-cells = <0>;
            bindings = <&kp F2>, <&kp ENTER>;

            tapping-term-ms = <250>;
        };

        lt_space: lt_space {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_SPACE";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            quick-tap-ms = <200>;
            tapping-term-ms = <150>;
        };

        lt_backspace: lt_backspace {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_BACKSPACE";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <(-1)>;
        };

        globe_paste: globe_paste {
            compatible = "zmk,behavior-hold-tap";
            label = "GLOBE_PASTE";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <149>;
        };

        minipcpass_globe: minipcpass_globe {
            compatible = "zmk,behavior-tap-dance";
            label = "MINIPCPASS_GLOBE";
            #binding-cells = <0>;
            bindings = <&miniPC_pass>, <&kp GLOBE>;
        };

        ipad_toggle_layer: ipad_toggle_layer {
            compatible = "zmk,behavior-toggle-layer";
            label = "IPAD_TOGGLE_LAYER";
            #binding-cells = <1>;
        };

        Bluetooth_switch: Bluetooth_switch {
            compatible = "zmk,behavior-tap-dance";
            label = "BLUETOOTH_SWITCH";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&bt BT_SEL 1>;
        };

        Shift_enter: Shift_enter {
            compatible = "zmk,behavior-hold-tap";
            label = "SHIFT_ENTER";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W             &kp E         &kp R        &kp T                                                          &kp Y        &kp U  &kp I     &kp O           &kp P
&kp A             &kp S             &kp D         &kp F        &kp G              &kp LG(D)        &Bluetooth_switch          &kp H        &kp J  &kp K     &kp L           &Shift_enter RIGHT_SHIFT ENTER
&kp Z             &kp X             &kp C         &kp V        &kp B              &mt GLOBE A      &ipad_toggle_layer 7       &kp N        &kp M  &mkp MB1  &mt RCTRL SEMI  &kp DELETE
&mt LEFT_GUI ESC  &kp LEFT_CONTROL  &kp LEFT_ALT  &lt 3 GLOBE  &lt_space 2 SPACE  &lt 1 TAB        &lt_backspace 1 BACKSPACE  &lt 2 RC(P)                                   &kp RG(F)
            >;

            sensor-bindings = <&encoder_msc_up_down>;
        };

        Symbol {
            bindings = <
&kp F6           &kp F7             &kp F8          &kp F9           &kp F10                                                       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS       &kp TILDE         &kp PIPE
&kp EXCLAMATION  &kp DOUBLE_QUOTES  &kp_up_arrow    &kp HASH         &kp AMPERSAND      &ipad_pass              &id                &kp SINGLE_QUOTE      &kp AT_SIGN            &kp UNDERSCORE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&kp LEFT_SHIFT   &kp_left_arrow     &kp_down_arrow  &kp_right_arrow  &kp LS(LG(SPACE))  &AMC_pass               &minipcpass_globe  &kp GRAVE             &kp CARET              &kp COMMA       &kp PERIOD        &kp SLASH
&kp LEFT_GUI     &kp LEFT_CONTROL   &kp LEFT_ALT    &kp LC(LA(F5))   &kp LC(LG(F5))     &kp LS(LC(LG(F5)))      &kp RC(Z)          &kp RC(Y)                                                                      &kp BACKSLASH
            >;

            sensor-bindings = <&inc_dec_kp BACKSPACE DELETE>;
        };

        FUNCTION {
            bindings = <
&kp LA(F4)                &kp LC(W)         &kp F4         &kp LC(R)              &kp LC(T)                                            &kp RC(RA(TAB))                    &kp RS(RC(TAB))      &kp RG(F5)      &kp RC(TAB)      &kp RC(RS(RA(TAB)))
&kp LC(A)                 &kp LA(LG(M))     &kp LA(EQUAL)  &kp LG(LA(F))          &kp LC(EQUAL)  &kp LC(B)            &kp RC(AT_SIGN)  &kp RA(LEFT_ARROW)                 &kp RA(RIGHT_ARROW)  &kp UP_ARROW    &kp RG(V)        &globe_paste GLOBE RC(V)
&mt LEFT_SHIFT LA(SLASH)  &kp LA(LBKT)      &kp LC(N)      &kp LA(RIGHT_BRACKET)  &kp LC(MINUS)  &mt GLOBE LC(S)      &kp RC(R)        &mt RIGHT_COMMAND RS(RC(PAGE_UP))  &kp LEFT_ARROW       &kp DOWN_ARROW  &kp RIGHT_ARROW  &mt LCTRL RS(RC(PAGE_DOWN))
&mt LEFT_GUI ESCAPE       &kp LEFT_CONTROL  &kp LEFT_ALT   &kp LC(LS(A))          &kp LC(N0)     &kp LC(LS(T))        &kp RC(X)        &kp RC(C)                                                                                &mt RIGHT_SHIFT RC(F)
            >;

            sensor-bindings = <&inc_dec_kp BACKSPACE SPACE>;
        };

        NUM {
            bindings = <
&kp RS(TAB)          &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp TAB                                                &kp BACKSLASH          &kp DOLLAR    &kp COLON        &kp TILDE         &kp PERCENT
&kp LEFT_ARROW       &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp RIGHT_ARROW  &trans             &kp RC(PG_UP)      &kp KP_PLUS            &kp KP_MINUS  &kp KP_ASTERISK  &kp KP_SLASH      &kp ENTER
&kp BACKSPACE        &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &F2_Enter        &double_kp_00      &kp RC(PAGE_DOWN)  &kp KP_EQUAL           &kp F4        &mt RCTRL COMMA  &mt RCTRL PERIOD  &kp DELETE
&mt LEFT_GUI ESCAPE  &kp KP_NUMBER_0  &kp SPACE        &kp LS(LA(L))    &kp LS(LA(M))    &kp LG(C)          &kp BACKSPACE      &kp RS(RA(RC(RG(C))))                                                   &mt RIGHT_SHIFT RC(K)
            >;

            sensor-bindings = <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans             &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans             &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &kp RIGHT_CONTROL  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                     &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &kp C_VOL_DN   &kp C_MUTE        &kp C_VOLUME_UP  &trans                      &trans         &kp RS(RC(TAB))         &kp RC(SPACE)           &kp RS(RC(PAGE_UP))      &trans
&trans  &kp C_PREV     &kp C_PLAY_PAUSE  &kp C_NEXT       &trans  &trans      &trans  &trans         &kp RC(TAB)             &kp RS(RC(UP_ARROW))    &kp RS(RC(PAGE_DOWN))    &trans
&trans  &kp C_BRI_DEC  &kp C_SLEEP       &kp C_BRI_UP     &trans  &trans      &trans  &kp LS(SPACE)  &kp RS(RC(LEFT_ARROW))  &kp RS(RC(DOWN_ARROW))  &kp RS(RC(RIGHT_ARROW))  &trans
&trans  &bt BT_SEL 0   &bt BT_SEL 1      &trans           &trans  &trans      &trans  &trans                                                                                  &trans
            >;
        };

        ipad {
            bindings = <
&kp Q               &kp M                   &kp F           &kp N                    &kp C                                       &kp RA(LEFT_ARROW)      &kp RC(UP_ARROW)    &kp UP_ARROW  &kp RS(RC(UP_ARROW))    &kp RA(RIGHT_ARROW)
&kp LG(LEFT_ARROW)  &kp LC(LEFT_ARROW)      &kp BACKSLASH   &kp LC(RIGHT_ARROW)      &kp LG(RIGHT_ARROW)  &kp D       &trans     &kp RC(RS(LEFT_ARROW))  &kp RC(DOWN_ARROW)  &kp H         &kp RS(RC(DOWN_ARROW))  &kp RS(RC(RIGHT_ARROW))
&kp GRAVE           &kp LC(LS(LEFT_ARROW))  &kp DOWN_ARROW  &kp LS(LC(RIGHT_ARROW))  &kp H                &trans      &trans     &kp GRAVE               &kp LEFT_ARROW      &mkp MB1      &kp RIGHT_ARROW         &kp RG(BACKSLASH)
&kp SPACE           &kp LS(A)               &kp A           &trans                   &kp GLOBE            &kp R       &kp RS(A)  &kp A                                                                             &kp Q
            >;
        };
    };
};
